# Copy to .env. Never commit .env.
#
# Two deploy targets share this file. Local Docker is the default; the Supabase
# block below is commented out. The application code is identical for both -
# only these values change.

# ============================================================================
# LOCAL DOCKER (default)
# ============================================================================
#
# These four are read by docker-compose.yml and by
# infra/postgres/init/01-app-role.sh to build the local postgres container.
# The application NEVER reads them - app/config.py has no POSTGRES_USER field
# and ignores unknown keys. The app reads DATABASE_URL and nothing else.
#
# So on Supabase these are irrelevant: Supabase already created the cluster and
# the `postgres` role, and 01_bootstrap_app_role.sql created llmobserve_app.
# Leave them as-is; they only affect the local container.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llmobserve
POSTGRES_PORT=5432

# The restricted role the API connects as. Must not be a superuser and must not
# have BYPASSRLS: row-level security does not apply to either, so tenant
# isolation depends on this. Created locally by
# infra/postgres/init/01-app-role.sh.
APP_DB_USER=llmobserve_app
APP_DB_PASSWORD=llmobserve_app

REDIS_PORT=6379

# "session"     - a connection this process owns (local Docker, Supabase direct,
#                 or Supavisor session mode on 5432). SQLAlchemy pools it.
# "transaction" - Supavisor transaction mode (6543) or pgbouncer. Forces
#                 NullPool and disables prepared statements.
DB_POOL_MODE=session

# Fail readiness if the runtime role can bypass RLS. Leave this on.
DB_REQUIRE_RLS=true

# ============================================================================
# API
# ============================================================================

API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

INGEST_MAX_TRACES_PER_BATCH=1000
INGEST_MAX_OBSERVATIONS_PER_BATCH=5000

# How far outside the present an observation's started_at may be before it is
# dropped. Dropped observations are counted in the 202 response as
# `rejected_observations` and logged at WARNING; the rest of the batch is still
# written, so one client with a bad clock cannot fail a whole request.
#
# These MUST stay inside the partition window that migration 0003 maintains,
# which runs current_date - 8 .. current_date + 30. Raising the age below
# without raising DAYS_BEHIND in that migration reintroduces the bug it fixed:
# an observation with no matching partition lands in observations_default, and
# ensure_observations_partitions() then permanently refuses to create that day's
# partition, so the whole day stops being pruned.
#
# The asymmetry is intended. Late delivery is normal - buffering, offline
# queues, retry backoff. A timestamp days in the future only means a bad clock.
INGEST_MAX_EVENT_AGE_DAYS=7
INGEST_MAX_EVENT_FUTURE_DAYS=1

# ============================================================================
# SUPABASE (uncomment to target a Supabase project)
# ============================================================================
#
# Supabase is used as managed Postgres and nothing else - no Supabase Auth, no
# PostgREST, no `supabase db push`. Alembic stays the single source of schema
# truth. This is what keeps "self-hostable" meaning "bring your own Postgres"
# rather than "install all of Supabase".
#
# Redis is NOT provided by Supabase. Keep running it from docker-compose, or
# point REDIS_URL at a managed instance.
#
# Setting DATABASE_URL below overrides the local-container default that
# docker-compose.yml would otherwise compose from POSTGRES_* / APP_DB_*. That is
# the only switch: uncomment it and the API talks to Supabase.
#
# Prerequisites, in order:
#   1. Run infra/supabase/01_bootstrap_app_role.sql in the SQL Editor.
#   2. Enable pg_cron:  Dashboard > Database > Extensions.
#   3. make migrate-remote
#   4. Run infra/supabase/02_verify_tenant_isolation.sql.
#   5. make check-rls  &&  make dev-supabase
#
# Note the username format. Through the pooler, the project ref is appended to
# the role name after a dot; on a direct connection it is not.
#
#   direct              llmobserve_app
#   pooler (5432/6543)  llmobserve_app.<PROJECT_REF>
#
# `?ssl=require` is required - asyncpg does not negotiate TLS by default and
# Supabase will refuse the connection without it.

# --- Runtime connection ---
#
# Cloud Run / anything autoscaling -> transaction mode (6543) + DB_POOL_MODE=transaction.
# Each instance holds its own pool, so a pooled config exhausts the project's
# connection cap as instances scale out.
#
# DATABASE_URL=postgresql+asyncpg://llmobserve_app.<PROJECT_REF>:<APP_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?ssl=require
# DB_POOL_MODE=transaction
#
# Passwords go in the URL percent-encoded. Reserved characters silently truncate
# the parse rather than erroring: a literal `@` ends the userinfo section, so
# `p@ss` makes the parser read `p` as the password and `ss` as the start of the
# host. Encode `@` as %40, `:` as %3A, `/` as %2F, `#` as %23, `?` as %3F.
#
# A long-lived single-process server can instead use session mode (5432) with
# DB_POOL_MODE=session, which keeps prepared statements enabled:
#
# DATABASE_URL=postgresql+asyncpg://llmobserve_app.<PROJECT_REF>:<APP_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?ssl=require

# --- Migration connection ---
#
# DDL runs over session mode or a direct connection, never 6543. This is also
# the one connection that legitimately uses the admin role, since it creates
# the tables and grants the app role its privileges.
#
# SUPABASE_MIGRATION_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?ssl=require
#
# The direct connection (db.<PROJECT_REF>.supabase.co:5432) is IPv6-only unless
# you have the IPv4 add-on, which is why the pooler hostname is the default here.
