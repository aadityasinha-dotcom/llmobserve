# Backend base URL, no trailing slash. Server-only: never prefix NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8000

# Google OAuth client id - the same one the API is configured with. A public
# identifier, used to build the sign-in redirect. The client SECRET is not set
# here: only the API holds it.
GOOGLE_CLIENT_ID=

# Optional. The public origin of this dashboard, if the request's own origin is
# not it (a proxy in front). Sign-in redirects to $APP_URL/auth/google/callback,
# which must be registered in Google Cloud Console and in the API's
# AUTH_REDIRECT_URIS.
# APP_URL=https://dashboard.example.com

# Optional. Where `make types` refetches the contract from; unset uses the
# openapi.json committed at the repo root.
# OPENAPI_URL=https://ci.example/llm-observe/openapi.json
