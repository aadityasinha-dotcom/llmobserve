# Backend base URL, no trailing slash. Server-only: never prefix NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8000

# API key issued for a project. Sent as `Authorization: Bearer <key>` by the
# route handlers only. Server-only: this must never reach the browser bundle.
LLMOBSERVE_API_KEY=

# Optional. Where `make types` refetches the contract from; unset uses the
# openapi.json committed at the repo root.
# OPENAPI_URL=https://ci.example/llm-observe/openapi.json
