            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only traces with started_at >= this (inclusive).",
              "title": "From"
            },
            "description": "Only traces with started_at >= this (inclusive)."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only traces with started_at < this (exclusive).",
              "title": "To"
            },
            "description": "Only traces with started_at < this (exclusive)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
