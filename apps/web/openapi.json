          "400": {
            "description": "Malformed cursor"
          },
          "401": {
            "description": "Missing, unrecognised, or revoked API key"
          },
          "403": {
            "description": "Key lacks the 'read' scope"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/traces/{trace_id}": {
      "get": {
        "tags": [
          "traces"
        ],
        "summary": "One trace with all of its observations",
        "description": "Return one trace and every observation under it, payloads included.\n\nObservations come back flat and ordered by started_at, with\n`parent_observation_id` intact; the client assembles the tree. Nesting is not\nvalidated here - the column carries no foreign key on purpose, so a parent\nthat is still in flight is expected rather than corrupt.\n\nA trace in another project is a 404, not a 403. Distinguishing the two would\nconfirm that an id exists, which is a cross-tenant disclosure however small;\nRLS makes the row invisible and the absence is reported as absence.",
        "operationId": "get_trace_v1_traces__trace_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Trace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unrecognised, or revoked API key"
          },
          "403": {
            "description": "Key lacks the 'read' scope"
          },
          "404": {
            "description": "No such trace in this project"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
