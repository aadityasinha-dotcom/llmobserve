{
  "openapi": "3.1.0",
  "info": {
    "title": "llm-observe API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "description": "Liveness. Deliberately does not touch the database.\n\nStill fails when configuration is invalid: an instance that cannot read its\nown settings cannot serve, and reporting \"ok\" would hide that.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readyz",
        "description": "Readiness: Postgres is reachable and row-level security is in force.\n\nRaising here is intentional. An instance whose runtime role bypasses RLS\nmust never receive traffic, so a misconfigured DATABASE_URL fails the\ndeploy loudly instead of silently serving cross-tenant data.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Ingest a batch of traces and observations",
        "description": "Accept a batch, write it, and return.\n\n202 rather than 201: what is promised is durability, not that any particular\nrow was newly created. A retry of an already-stored batch is a success and\nreports the same counts as the original.",
        "operationId": "ingest_v1_ingest_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-SDK-Version",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Sdk-Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestBatch"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unrecognised, or revoked API key"
          },
          "403": {
            "description": "Key lacks the 'ingest' scope"
          },
          "413": {
            "description": "Batch exceeds the configured size limits"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/traces": {
      "get": {
        "tags": [
          "traces"
        ],
        "summary": "List traces, newest first",
        "description": "Return one page of traces, newest first, without their payloads.\n\nOrdered by `(started_at DESC, id DESC)`. The id is not decoration: traces\nwritten by one batch routinely share a timestamp, and it is the tiebreaker\nthat gives the sort a total order, which is the whole basis for the cursor\nbeing stable across pages.\n\nThe range filters apply to `started_at` - event time, when the run actually\nhappened - not to `created_at`, which is when this server received it. They\ndiffer whenever a client buffered, retried, or was offline.",
        "operationId": "list_traces_v1_traces_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous page.",
              "title": "Cursor"
            },
            "description": "Opaque cursor from a previous page."
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact trace name match.",
              "title": "Name"
            },
            "description": "Exact trace name match."
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact match on the client's end-user id.",
              "title": "User Id"
            },
            "description": "Exact match on the client's end-user id."
          },
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact match on the client's session id.",
              "title": "Session Id"
            },
            "description": "Exact match on the client's session id."
          },
          {
